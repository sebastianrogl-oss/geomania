rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Spieler-Profil: nur der Besitzer darf sein eigenes Dokument lesen/schreiben.
    //
    // Das {document=**} am Ende ist NICHT kosmetisch: Regeln vererben sich in
    // Firestore nicht auf Unterkollektionen. Ohne diesen Zusatz wäre
    // spieler/{uid}/stand/aktuell — die Spielstand-Sicherung — für niemanden
    // schreibbar, auch nicht für den Besitzer selbst. Das Sichern schlüge
    // still fehl (permission-denied), und es fiele erst auf, wenn jemand das
    // Gerät wechselt und nichts vorfindet.
    match /spieler/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tages-Ranglisten: jeder angemeldete Nutzer darf die Rangliste lesen,
    // aber nur seinen eigenen Eintrag schreiben.
    match /ranglisten/{challengeId}/{tag}/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      // Zwei Fälle dürfen löschen:
      //
      // 1. DER EIGENE EINTRAG, jederzeit. Gebraucht von der Kontolöschung
      //    (AuthService.kontoLoeschen, Schritt 4): Die Einträge liegen
      //    ausserhalb von spieler/{uid} und überlebten das Löschen des
      //    Kontos sonst bis zum Rollfenster — mit Anzeigename, öffentlich
      //    lesbar. Ein früherer "eigener Eintrag jederzeit löschbar"-Fall
      //    war einmal drin und wurde entfernt, als sein damaliger Aufrufer
      //    (Ranglisten-Reset über "Fortschritt zurücksetzen") wegfiel; die
      //    Kontolöschung braucht ihn zwingend wieder.
      //
      //    Bewusst über den PFAD-Platzhalter {uid} statt über
      //    resource.data.uid: Auf ein Dokument, das es nicht gibt, ist
      //    `resource` null, und eine Bedingung darauf schlägt fehl. Die
      //    Löschung rechnet ihre Tages-Keys aus, statt sie zu listen
      //    (Client-SDKs können keine Subcollections auflisten), trifft
      //    dabei zwangsläufig auf Tage ohne Eintrag — und ein Batch, in dem
      //    ein einziges Löschen abgelehnt wird, scheitert vollständig.
      //
      // 2. JEDER Eintrag, der älter als 14 Tage ist — auch ein fremder.
      //    Das ist das Rollfenster: Es erlaubt die clientseitige
      //    Bereinigung alter Tage ohne Cloud Function, ohne ein generelles
      //    Lösch-Recht auf aktuelle Einträge anderer Spieler zu öffnen.
      //
      // Die Reihenfolge ist nicht beliebig: || wertet von links aus und
      // bricht bei true ab. Stünde die erstelltAm-Bedingung vorn, liefe die
      // Kontolöschung bei jedem leeren Tag zuerst in den null-resource-Fall.
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || resource.data.erstelltAm < request.time - duration.value(14, 'd'));
    }

    // Portfolio Alltime-Rangliste: jeder angemeldete Nutzer darf lesen,
    // aber nur seinen eigenen Eintrag schreiben.
    match /portfolio_alltime/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // Löschen braucht eine EIGENE Regel, auch wenn `write` in Firestore
      // create, update UND delete umfasst: Bei einem delete gibt es kein
      // eingehendes Dokument, `request.resource` ist null — die Bedingung
      // request.resource.data.uid == uid oben ist damit nie erfüllbar. Der
      // Alltime-Eintrag war deshalb faktisch unlöschbar und überlebte die
      // Kontolöschung; anders als die Tages-Ranglisten hat er nicht einmal
      // ein Rollfenster, das ihn irgendwann abgeräumt hätte.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Anzeigename-Reservierungen: Dokument-ID = normalisierter (kleinge-
    // schriebener, whitespace-vereinheitlichter) Anzeigename. Verhindert
    // doppelte Namen in der Rangliste. "create" wird von Firestore nur
    // zugelassen, wenn das Dokument noch NICHT existiert -> das ist der
    // eigentliche Schutz gegen zwei Spieler, die gleichzeitig denselben
    // Namen reservieren (die Firestore-Transaktion in
    // setzeAnzeigenameEindeutig() sorgt zusätzlich dafür, dass Freigabe des
    // alten + Anlage des neuen Namens atomar zusammen passieren). "update"
    // bewusst nicht erlaubt: beim Ändern des Namens wird die alte
    // Reservierung gelöscht und eine neue angelegt, nie ein bestehendes
    // Dokument überschrieben — eine Regel-Variante mit
    // "request.resource.data.uid == request.auth.uid" als zusätzliche
    // OR-Bedingung für "write" (wie ursprünglich vorgeschlagen) würde genau
    // das erlauben: jeder könnte ein FREMDES Reservierungs-Dokument
    // überschreiben, indem er im Request-Payload einfach die eigene uid
    // einträgt — deshalb bewusst bei den getrennten create/delete-Regeln
    // ohne update geblieben.
    match /anzeigenamen_reserviert/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
