<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Geomania</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>geomania</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Rueckweg aus der Google-Anmeldung in die App.

	     Der Wert ist die REVERSED_CLIENT_ID aus GoogleService-Info.plist
	     (dieselbe Datei, die im Resources-Build-Schritt liegt) — also die
	     umgedrehte CLIENT_ID. Ohne diesen URL-Typ oeffnet sich zwar der
	     Google-Dialog, aber das Ergebnis findet nicht zurueck: Die Anmeldung
	     bricht ab und die App meldet "hat nicht geklappt".

	     WER DIE PLIST AUSTAUSCHT, MUSS HIER VORBEI: Bei einem neuen
	     OAuth-Client aendert sich der Wert, und eine veraltete Zeile faellt
	     nicht beim Bauen auf, sondern erst beim Anmeldeversuch auf dem
	     Geraet. ios_anmeldung_test.dart vergleicht beide Dateien deshalb
	     gegeneinander. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.514970095088-3gf2nh141ahlummjltc0n2gpohoeia34</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-4580295867570231~8188197920</string>
	<!-- Text des ATT-Dialogs (App Tracking Transparency), den iOS ab Version 14
	     vor dem Zugriff auf die Werbe-ID zeigt. OHNE diesen Schlüssel darf die
	     Abfrage gar nicht erscheinen, und die Werbung bleibt dauerhaft
	     unpersonalisiert. Bewusst in der Sprache des Nutzens formuliert, nicht
	     in Rechtsdeutsch: Apple lehnt Texte ab, die nur die Erlaubnis
	     einfordern, ohne zu sagen, wofür. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Damit dir GeoMania Werbung zeigen kann, die zu dir passt — und die App für dich kostenlos bleibt.</string>
	<!-- SKAdNetwork-Kennungen der Werbenetzwerke, die Installationen messen
	     dürfen. HIER STEHT NUR GOOGLE SELBST: Die vollständige Liste der
	     AdMob-Vermittlungspartner umfasst über hundert Einträge, sie ändert
	     sich laufend, und sie gehört aus Googles eigener Dokumentation
	     übernommen (developers.google.com/admob/ios/. Suche nach
	     SKAdNetworkItems). Eine aus dem Gedächtnis getippte Liste wäre
	     schlimmer als keine — falsche Kennungen fallen niemandem auf, kosten
	     aber Zuordnung und damit Umsatz. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
