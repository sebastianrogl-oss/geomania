<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Anmelden mit Apple". Ohne dieses Entitlement meldet iOS beim
	     Anmeldeversuch einen Fehler, den die App als "noch nicht eingerichtet"
	     anzeigt (AnmeldeErgebnis.nichtEingerichtet).

	     Die Datei allein genuegt NICHT: Die App-ID com.northlight.geomania
	     braucht im Apple Developer Portal zusaetzlich die Capability
	     "Sign In with Apple". Fehlt sie dort, stellt der Signierdienst ein
	     Provisioning-Profil ohne dieses Entitlement aus, und der Build
	     scheitert entweder beim Signieren oder verhaelt sich zur Laufzeit
	     genau wie ohne die Datei. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
